# ============================================
# SEC Event Intelligence API - Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# NEVER commit your actual .env file to GitHub!

# APPLICATION SETTINGS
SEC_APP_NAME="YASEN-ALPHA SEC Event Intelligence API"
SEC_APP_VERSION="1.0.0"
SEC_ENVIRONMENT="development"
SEC_DEBUG=true
SEC_HOST="0.0.0.0"
SEC_PORT=8000
SEC_WORKERS=1

# SEC EDGAR SETTINGS (REQUIRED)
SEC_SEC__USER_AGENT="YASEN-ALPHA-SEC-API/1.0 (your-email@example.com)"
SEC_SEC__RATE_LIMIT=10
SEC_SEC__TIMEOUT=30
SEC_SEC__MAX_RETRIES=3

# CACHE SETTINGS
SEC_CACHE__DEFAULT_TTL=86400
SEC_CACHE__COMPANY_TTL=604800
SEC_CACHE__FILING_TTL=86400
SEC_CACHE__MAX_SIZE=10000

# RATE LIMITING (requests per minute)
SEC_RATE_LIMIT__FREE=10
SEC_RATE_LIMIT__PRO=20
SEC_RATE_LIMIT__ULTRA=40
SEC_RATE_LIMIT__MEGA=60
SEC_RATE_LIMIT__WINDOW=60
SEC_RATE_LIMIT__SOFT_THRESHOLD=0.80

# PRICING TIERS
SEC_PRICING__FREE_REQUESTS=500
SEC_PRICING__PRO_REQUESTS=10000
SEC_PRICING__PRO_PRICE=25
SEC_PRICING__ULTRA_REQUESTS=50000
SEC_PRICING__ULTRA_PRICE=75
SEC_PRICING__MEGA_REQUESTS=200000
SEC_PRICING__MEGA_PRICE=150

# LOGGING
SEC_LOGGING__LEVEL="INFO"
SEC_LOGGING__JSON_FORMAT=false

# SECURITY (for production)
SEC_SECURITY__SECRET_KEY="change-this-in-production"
SEC_SECURITY__ALGORITHM="HS256"
